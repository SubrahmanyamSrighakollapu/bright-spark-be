NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
# Express proxy-addr syntax. Keep this restricted to the actual Nginx/load-balancer
# address or subnet; never use true in production. Examples: loopback or 10.0.0.10
TRUST_PROXY=loopback
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=bright_spark
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=development-access-secret-change-me-123456
JWT_REFRESH_SECRET=development-refresh-secret-change-me-12345
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
LOG_LEVEL=info
SWAGGER_ENABLED=true
SEED_ADMIN_EMAIL=admin@brightspark.com
SEED_ADMIN_PASSWORD=Admin@1234567

# NOBLE AEPS V2 (backend only; never expose these values to the frontend)
NOBLE_AEPS_ENABLED=true
NOBLE_API_KEY=D8B228D8-2AA9-4724-A2D4-36B4C583D2B1
NOBLE_API_VALUE=4ed795039988b844bf77
NOBLE_AUTH_BASE_URL=https://service.noblewebstudio.in/api/v1.0
NOBLE_AEPS_BASE_URL=https://aeapi.noblewebstudio.in/v2.0/aeps
NOBLE_HTTP_TIMEOUT_MS=30000
